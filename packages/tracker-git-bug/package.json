{
  "name": "ao-plugin-tracker-git-bug",
  "version": "0.1.0",
  "private": true,
  "description": "AO tracker plugin: git-bug (https://github.com/git-bug/git-bug)",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt .",
    "lint": "oxlint .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "build": "tsc -p .",
    "clean": "rm -rf dist",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@aoagents/ao-core": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
